# Clerk — https://clerk.com/docs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_secret_key_here

# Neon — https://neon.tech/docs
NEON_BRANCH=main
DATABASE_URL="postgresql://username:password@your-pooler-endpoint/neondb?channel_binding=require&sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://username:password@your-direct-endpoint/neondb?channel_binding=require&sslmode=require"

# Neon AI Gateway (optional)
NEON_AI_GATEWAY_TOKEN=nt_live_your_token_here
NEON_AI_GATEWAY_BASE_URL=https://your-gateway-endpoint.ai.c-4.us-east-2.aws.neon.tech

# Seed data — Clerk user ID for `npx prisma db seed`
SEED_USER_ID=your_clerk_user_id_here

# E2E Testing — Clerk test user for Playwright
E2E_CLERK_USER_EMAIL=test@example.com
E2E_CLERK_USER_PASSWORD=your_test_password_here
